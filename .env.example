# Copy this file to .env.local and fill in real values for your environment.
# Never commit .env.local — it is already in .gitignore.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# A long, random, secret string used to sign admin session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# The public URL the site is deployed at (used for the sitemap, canonical
# URLs, and Open Graph tags). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# OPTIONAL — contact form email notifications (Resend)
# Every inquiry is always saved to the database and visible at /admin/inquiries
# regardless of these settings. Set these as well if you also want an email
# sent for each new inquiry.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
CONTACT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# OPTIONAL — storage paths
# Override only if you need the SQLite database or uploaded files to live
# somewhere other than the defaults (./data and ./public/uploads).
# ---------------------------------------------------------------------------
DATA_DIR=
UPLOAD_DIR=
